{
  "name": "@mvr2t/desktop",
  "productName": "MVR2T",
  "private": true,
  "version": "0.1.0",
  "description": "MVR2T - Local Media Studio desktop app (Electron + Vite + React + TypeScript)",
  "author": "MVR2T",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -s command-electron -n vite,electron \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "npm run build:electron && wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --tsconfig=tsconfig.electron.json --sourcemap --outdir=dist-electron",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "vitest run",
    "electron:install": "install-electron",
    "dist:win": "npm run electron:install && npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run electron:install && npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/noto-sans-tc": "5.1.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "html-to-image": "1.11.11",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.4",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "cross-env": "7.0.3",
    "electron": "44.10.2",
    "electron-builder": "26.18.1",
    "esbuild": "0.28.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "wait-on": "8.0.1"
  }
}
